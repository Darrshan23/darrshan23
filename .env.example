# Resend (https://resend.com) API key used by /api/contact to deliver contact-form
# submissions. Without it, the form gracefully falls back to a pre-filled mailto: link.
RESEND_API_KEY=

# Optional "From" address for outgoing contact-form emails. Must be a domain verified
# in your Resend account, or leave unset to use Resend's shared sandbox sender.
CONTACT_FROM="Portfolio Contact <onboarding@resend.dev>"
